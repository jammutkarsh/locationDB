# Copy this file to .env and fill in your values.
# Do NOT commit .env to source control.

# ---------------------------------------------------------------------------
# Database backend: "postgres" | "sqlite"
# ---------------------------------------------------------------------------
DB_DRIVER=sqlite

# ---------------------------------------------------------------------------
# PostgreSQL (only required when DB_DRIVER=postgres)
# Pick ONE of the two options below.
# ---------------------------------------------------------------------------
# Option 1 — full connection URL. Wins if both are set.
#   postgres://user:password@host:5432/dbname?sslmode=disable
DATABASE_URL=

# Option 2 — standard libpq variables. Leave DATABASE_URL empty and psql
# resolves the connection itself (also honours ~/.pgpass and PGSERVICE).
# PGHOST=localhost
# PGPORT=5432
# PGUSER=locationdb_user
# PGPASSWORD=
# PGDATABASE=locationdb
# PGSSLMODE=require

# ---------------------------------------------------------------------------
# SQLite (only required when DB_DRIVER=sqlite)
# ---------------------------------------------------------------------------
# Path to the .db file that will be created / populated.
SQLITE_DB_PATH=./locationdb.db

# ---------------------------------------------------------------------------
# Internal counters (used for validation only)
# The number 26 is chosen because there are some known unmapped cities in the
# Geonames data — Special Administrative Regions / independent territories
# that have no corresponding admin code in the Geonames admin-codes files.
# ---------------------------------------------------------------------------
INIT_COUNT=
SYNC_COUNT=
